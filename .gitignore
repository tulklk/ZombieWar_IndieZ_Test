# Unity generated folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Mm]emoryCaptures/
UserSettings/

# Unity cache / artifacts
/**/[Aa]ssets/AssetStoreTools*
**/.vs/
**/.idea/
**/.vscode/
**/*.pidb
**/*.booproj
**/*.svd
**/*.pdb
**/*.mdb
**/*.opendb
**/*.VC.db
**/*.VC.VC.opendb

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta
!/[Pp]ackages/**/*.meta
!/[Pp]roject[Ss]ettings/**/*.meta

# Autogenerated Visual Studio / Rider / VSCode files
.gradle/
.vsconfig
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs

# Unity3D generated meta files (keep normal *.meta for Assets)
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports
sysinfo.txt
crashlytics-build.properties

# Profiler captures
*.data
*.data.meta

# Builds / binary outputs
*.apk
*.aab
*.app
*.exe
*.dll
*.so
*.dylib
*.a
*.lib
*.ipa
*.zip
*.tar
*.tar.gz
*.7z

# OS files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# JetBrains Rider plugin
Assets/Plugins/Editor/JetBrains*

